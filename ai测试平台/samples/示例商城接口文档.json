{
  "openapi": "3.0.1",
  "info": {
    "title": "示例商城后台接口",
    "version": "1.0.0",
    "description": "用于演示导入、AI 生成用例、执行与报告的示例接口文档"
  },
  "servers": [
    { "url": "http://127.0.0.1:8080" }
  ],
  "paths": {
    "/api/v1/users/login": {
      "post": {
        "tags": ["用户"],
        "summary": "用户登录",
        "description": "使用用户名和密码登录，返回 token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginBody" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResp" }
              }
            }
          },
          "401": { "description": "用户名或密码错误" }
        }
      }
    },
    "/api/v1/users": {
      "get": {
        "tags": ["用户"],
        "summary": "查询用户列表",
        "parameters": [
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "size", "in": "query", "required": false, "schema": { "type": "integer", "maximum": 100, "default": 10 } },
          { "name": "keyword", "in": "query", "required": false, "schema": { "type": "string", "maxLength": 50 } }
        ],
        "responses": {
          "200": {
            "description": "用户列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserListResp" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["用户"],
        "summary": "创建用户",
        "description": "创建用户，name/email 必填",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateUserBody" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserDetailResp" }
              }
            }
          },
          "400": { "description": "参数错误" }
        }
      }
    },
    "/api/v1/users/{id}": {
      "get": {
        "tags": ["用户"],
        "summary": "查询用户详情",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "用户详情",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserDetailResp" }
              }
            }
          },
          "404": { "description": "用户不存在" }
        }
      },
      "put": {
        "tags": ["用户"],
        "summary": "更新用户",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateUserBody" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserDetailResp" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["用户"],
        "summary": "删除用户",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CommonResp" }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders": {
      "get": {
        "tags": ["订单"],
        "summary": "查询订单列表",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string", "enum": ["PENDING", "PAID", "SHIPPED", "CANCELLED"] } },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": {
            "description": "订单列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrderListResp" }
              }
            }
          },
          "401": { "description": "未登录或 token 失效" }
        }
      },
      "post": {
        "tags": ["订单"],
        "summary": "创建订单",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateOrderBody" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrderDetailResp" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "LoginBody": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "minLength": 3, "maxLength": 20, "example": "tester01" },
          "password": { "type": "string", "minLength": 6, "maxLength": 32, "example": "123456" }
        }
      },
      "LoginResp": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 0 },
          "message": { "type": "string", "example": "success" },
          "data": {
            "type": "object",
            "properties": {
              "token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiJ9.demo.token" },
              "userId": { "type": "integer", "example": 1 }
            }
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "张三" },
          "email": { "type": "string", "format": "email", "example": "zhangsan@example.com" },
          "role": { "type": "string", "enum": ["ADMIN", "USER"], "example": "USER" }
        }
      },
      "UserListResp": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 0 },
          "data": {
            "type": "object",
            "properties": {
              "list": { "type": "array", "items": { "$ref": "#/components/schemas/User" } },
              "total": { "type": "integer", "example": 100 }
            }
          }
        }
      },
      "CreateUserBody": {
        "type": "object",
        "required": ["name", "email"],
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 20 },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["ADMIN", "USER"] }
        }
      },
      "UpdateUserBody": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 20 },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["ADMIN", "USER"] }
        }
      },
      "UserDetailResp": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 0 },
          "message": { "type": "string", "example": "success" },
          "data": { "$ref": "#/components/schemas/User" }
        }
      },
      "CommonResp": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 0 },
          "message": { "type": "string", "example": "success" }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1001 },
          "orderNo": { "type": "string", "example": "SO20260811001" },
          "status": { "type": "string", "enum": ["PENDING", "PAID", "SHIPPED", "CANCELLED"], "example": "PENDING" },
          "amount": { "type": "number", "example": 99.9 }
        }
      },
      "OrderListResp": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 0 },
          "data": {
            "type": "object",
            "properties": {
              "list": { "type": "array", "items": { "$ref": "#/components/schemas/Order" } },
              "total": { "type": "integer", "example": 20 }
            }
          }
        }
      },
      "CreateOrderBody": {
        "type": "object",
        "required": ["goodsId", "quantity"],
        "properties": {
          "goodsId": { "type": "integer", "minimum": 1 },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 99 },
          "remark": { "type": "string", "maxLength": 100 }
        }
      },
      "OrderDetailResp": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 0 },
          "message": { "type": "string", "example": "success" },
          "data": { "$ref": "#/components/schemas/Order" }
        }
      }
    }
  }
}
