    &quot;sale_price&quot;: ${sale_price},&#xd;
    &quot;safety_stock&quot;: ${safety_stock},&#xd;
    &quot;status&quot;: &quot;${status}&quot;,&#xd;
    &quot;description&quot;: &quot;${description}&quot;&#xd;
}</stringProp>
