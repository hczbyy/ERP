          <hashTree>
            <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV 数据文件设置">
              <stringProp name="filename">E:/jmeter_pratice/ERP/基础数据/data/商品创建.txt</stringProp>
              <stringProp name="fileEncoding">UTF-8</stringProp>
              <stringProp name="variableNames">case_name,http_expected,biz_code_expected,code,name,spec,unit,barcode,category_id,purchase_price,sale_price,safety_stock,status,description</stringProp>
              <boolProp name="ignoreFirstLine">true</boolProp>
              <stringProp name="delimiter">,</stringProp>
              <boolProp name="quotedData">false</boolProp>
              <boolProp name="recycle">true</boolProp>
              <boolProp name="stopThread">false</boolProp>
              <stringProp name="shareMode">shareMode.thread</stringProp>
            </CSVDataSet>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
int actualHttp = prev.getResponseCode() as int
int expectHttp = vars.get(&quot;http_expected&quot;) as int
def expectBiz = vars.get(&quot;biz_code_expected&quot;).trim()

boolean ok = true
String msg = &quot;&quot;

//校验http状态码
if(actualHttp != expectHttp){
    ok = false
    msg += &quot;HTTP状态码错误，预期${expectHttp}，实际${actualHttp};&quot;
}

// biz_code_expected不为空才校验业务码
if(!expectBiz.isEmpty()){
    int actualBiz = json.code as int
    int eBiz = expectBiz as int
    if(actualBiz != eBiz){
        ok = false
        msg += &quot;业务code错误，预期${eBiz}，实际${actualBiz};&quot;
    }
}

if(ok){
    prev.setSuccessful(true)
}else{
    prev.setSuccessful(false)
    prev.setResponseMessage(msg + &quot; 响应:&quot; + prev.getResponseDataAsString())
}</stringProp>
            </JSR223Assertion>
            <hashTree/>
          </hashTree>
        </hashTree>
